torch.manual_seed(RANDOM_SEED)

class URLDataset(Dataset):
    def __init__(self, X, y):
        self.X = torch.FloatTensor(X)
        self.y = torch.FloatTensor(y)

    def __len__(self):
        return len(self.y)

    def __getitem__(self, idx):
        return self.X[idx], self.y[idx]

class AdvancedURLClassifier(nn.Module):
    def __init__(self, input_size):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(input_size, 512),
            nn.BatchNorm1d(512),
            nn.ReLU(),
            nn.Dropout(0.4),

            nn.Linear(512, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(),
            nn.Dropout(0.3),

            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.ReLU(),
            nn.Dropout(0.2),

            nn.Linear(128, 64),
            nn.BatchNorm1d(64),
            nn.ReLU(),

            nn.Linear(64, 1),
            nn.Sigmoid()
        )

    def forward(self, x):
        return self.model(x)

class CustomEnsemble:
    def __init__(self, models, weights=None):
        self.models = models
        self.weights = weights if weights is not None else [1/len(models)] * len(models)

    def predict_proba(self, X):
        predictions = np.zeros((X.shape[0], 2))
        for model, weight in zip(self.models, self.weights):
            predictions += weight * model.predict_proba(X)
        return predictions / sum(self.weights)

    def predict(self, X):
        proba = self.predict_proba(X)
        return (proba[:, 1] >= 0.5).astype(int)

def entropy(string):
    """Calculate Shannon entropy of a string"""
    prob = [string.count(c) / len(string) for c in set(string)]
    return -sum(p * np.log2(p) for p in prob)

def extract_advanced_features(url):
    """Extract advanced features from a URL"""
    parsed = urlparse(url)
    extracted = tldextract.extract(url)

    features = {
        'length': len(url),
        'num_dots': url.count('.'),
        'num_hyphens': url.count('-'),
        'num_underscores': url.count('_'),
        'num_digits': sum(c.isdigit() for c in url),
        'has_https': int(parsed.scheme == 'https'),
        'domain_length': len(extracted.domain),
        'num_subdomains': len(extracted.subdomain.split('.')) if extracted.subdomain else 0,
        'has_ip': int(bool(re.match(r'\d+\.\d+\.\d+\.\d+', extracted.domain))),
        'has_at_symbol': int('@' in url),
        'has_double_slash': int('//' in parsed.path),
        'has_hex': int(any(c.isdigit() or c.lower() in 'abcdef' for c in url)),
        'num_params': len(parsed.query.split('&')) if parsed.query else 0,
        'has_login': int('login' in url.lower()),
        'has_verify': int('verify' in url.lower()),
        'has_secure': int('secure' in url.lower()),

        # Advanced features
        'url_entropy': entropy(url),
        'domain_entropy': entropy(extracted.domain),
        'subdomain_entropy': entropy(extracted.subdomain) if extracted.subdomain else 0,
        'path_entropy': entropy(parsed.path) if parsed.path else 0,

        # Path analysis
        'path_length': len(parsed.path),
        'path_depth': len([x for x in parsed.path.split('/') if x]),
        'query_length': len(parsed.query),
        'fragment_length': len(parsed.fragment),

        # Ratios
        'digit_ratio': sum(c.isdigit() for c in url) / len(url) if url else 0,
        'letter_ratio': sum(c.isalpha() for c in url) / len(url) if url else 0,
        'special_char_ratio': sum(not c.isalnum() for c in url) / len(url) if url else 0,

        # Suspicious patterns
        'has_suspicious_words': int(bool(re.search(r'login|verify|account|secure|update', url.lower()))),
        'has_suspicious_tld': int(extracted.suffix in ['xyz', 'top', 'work', 'live', 'click']),
        'num_suspicious_patterns': len(re.findall(r'password|credential|signin|signup|payment', url.lower())),
    }

    return features

def fetch_phishing_urls_github(limit=URL_LIMIT):
    """Fetch phishing URLs from GitHub."""
    github_url = "https://phish.co.za/latest/ALL-phishing-links.tar.gz"
    try:
        response = requests.get(github_url)
        response.raise_for_status()
        tar_bytes = io.BytesIO(response.content)

        with tarfile.open(fileobj=tar_bytes, mode='r:gz') as tar:
            urls = []
            for member in tar.getmembers():
                if member.name.endswith('.lst'):
                    f = tar.extractfile(member)
                    if f:
                        content = f.read().decode('utf-8')
                        urls.extend(content.strip().split('\n'))

        print(f"Fetched {len(urls)} URLs from GitHub")
        return urls[:limit]
    except Exception as e:
        print(f"Error fetching data: {e}")
        return []

def fetch_legitimate_urls_majestic(limit=URL_LIMIT):
    """Fetch legitimate URLs from Majestic Million."""
    majestic_url = "https://downloads.majestic.com/majestic_million.csv"
    try:
        response = requests.get(majestic_url)
        response.raise_for_status()
        csv_content = StringIO(response.text)
        df = pd.read_csv(csv_content, usecols=['Domain'], nrows=limit)
        return ["http://" + domain for domain in df['Domain']]
    except Exception as e:
        print(f"Error fetching data: {e}")
        return []

def process_features_in_batches(urls, labels):
    """Process features in batches."""
    features_list = []
    processed = 0
    total_batches = len(urls) // BATCH_SIZE + (1 if len(urls) % BATCH_SIZE != 0 else 0)

    for i in range(0, len(urls), BATCH_SIZE):
        batch_urls = urls[i:i + BATCH_SIZE]
        print(f"\nProcessing batch {(i//BATCH_SIZE)+1}/{total_batches}")

        batch_features = [extract_advanced_features(url) for url in batch_urls]
        features_list.extend(batch_features)

        processed += len(batch_urls)
        print(f"Processed {processed}/{len(urls)} URLs")
        gc.collect()

    return pd.DataFrame(features_list)

def process_tfidf_in_batches(urls, max_features=MAX_TFIDF_FEATURES):
    """Process TF-IDF features in batches."""
    print("\nFitting TF-IDF vectorizer...")
    tfidf = TfidfVectorizer(analyzer='char', ngram_range=(3,5), max_features=max_features)
    tfidf.fit(urls)
    feature_names = ['tfidf_' + f for f in tfidf.get_feature_names_out()]

    total_batches = len(urls) // BATCH_SIZE + (1 if len(urls) % BATCH_SIZE != 0 else 0)
    tfidf_features = np.zeros((len(urls), len(feature_names)))

    for i in range(0, len(urls), BATCH_SIZE):
        print(f"\nProcessing TF-IDF batch {(i//BATCH_SIZE)+1}/{total_batches}")
        batch_urls = urls[i:i + BATCH_SIZE]
        batch_features = tfidf.transform(batch_urls).toarray()
        tfidf_features[i:i + len(batch_urls)] = batch_features
        gc.collect()

    return pd.DataFrame(tfidf_features, columns=feature_names)

def plot_detailed_model_comparison(comparison):
    """Create a more detailed and readable model comparison visualization."""
    metrics = ['Accuracy', 'ROC AUC', 'Precision', 'Recall', 'F1']
    model_names = list(comparison.keys())

    # Create DataFrame for plotting
    plot_data = []
    for model in model_names:
        for metric in metrics:
            plot_data.append({
                'Model': model,
                'Metric': metric,
                'Score': comparison[model][metric],
                'Error': 0.001  # Assuming constant error for visualization
            })
    df_plot = pd.DataFrame(plot_data)

    # Create subplot for each metric
    fig, axes = plt.subplots(len(metrics), 1, figsize=(15, 4*len(metrics)))
    fig.suptitle('Detailed Model Performance Comparison', fontsize=16, y=1.02)

    for i, metric in enumerate(metrics):
        metric_data = df_plot[df_plot['Metric'] == metric]

        # Create bar plot with error bars
        sns.barplot(x='Score', y='Model', data=metric_data, ax=axes[i],
                   palette='viridis')

        # Customize the plot
        axes[i].set_title(f'{metric} Comparison')
        axes[i].set_xlim(0.95, 1.0)  # Zoom in on the relevant range
        axes[i].grid(True, alpha=0.3)

        # Add value labels
        for j, v in enumerate(metric_data['Score']):
            axes[i].text(v, j, f'{v:.4f}', va='center')

    plt.tight_layout()
    plt.show()

def analyze_best_model(best_model, X_test, y_test, feature_names, df_combined):
    try:
        # ROC Curve
        plt.figure(figsize=(10, 6))
        y_pred_proba = best_model['probabilities']
        fpr, tpr, _ = roc_curve(y_test, y_pred_proba)

        plt.plot(fpr, tpr, label=f'ROC curve (AUC = {roc_auc_score(y_test, y_pred_proba):.4f})')
        plt.plot([0, 1], [0, 1], 'k--')
        plt.xlim([0.0, 1.0])
        plt.ylim([0.0, 1.05])
        plt.xlabel('False Positive Rate')
        plt.ylabel('True Positive Rate')
        plt.title('ROC Curve for Best Model')
        plt.legend(loc="lower right")
        plt.grid(True, alpha=0.3)
        plt.show()

        # Precision-Recall Curve
        plt.figure(figsize=(10, 6))
        precision, recall, _ = precision_recall_curve(y_test, y_pred_proba)
        plt.plot(recall, precision)
        plt.xlabel('Recall')
        plt.ylabel('Precision')
        plt.title('Precision-Recall Curve')
        plt.grid(True, alpha=0.3)
        plt.show()

        if hasattr(best_model.get('model', {}), 'feature_importances_'):
            feature_importance = pd.DataFrame({
                'feature': feature_names,
                'importance': best_model['model'].feature_importances_
            }).sort_values('importance', ascending=False)

            plt.figure(figsize=(15, 8))
            sns.barplot(x='importance', y='feature', data=feature_importance.head(20),
                       palette='viridis')
            plt.title('Top 20 Most Important Features')
            plt.xlabel('Feature Importance')
            plt.tight_layout()
            plt.show()

            print("\nTop 20 Most Important Features:")
            print(feature_importance.head(20).to_string())
    except Exception as e:
        print(f"Error in model analysis: {e}")

def explore_dataset_characteristics(df_combined):
    """Create visualizations to explore the dataset characteristics."""

    # 1. Distribution of URL Lengths with KDE
    plt.figure(figsize=(12, 6))
    for label, name in [(0, 'Legitimate'), (1, 'Phishing')]:
        sns.kdeplot(data=df_combined[df_combined['label'] == label]['length'],
                   label=name, fill=True)
    plt.title('Distribution of URL Lengths')
    plt.xlabel('URL Length')
    plt.ylabel('Density')
    plt.legend()
    plt.show()

    # 2. Feature Correlations Heatmap
    plt.figure(figsize=(20, 16))
    numeric_cols = [col for col in df_combined.columns
                   if df_combined[col].dtype in ['int64', 'float64']
                   and col != 'label' and not col.startswith('tfidf_')]
    correlation = df_combined[numeric_cols].corr()
    mask = np.triu(np.ones_like(correlation))
    sns.heatmap(correlation, mask=mask, cmap='coolwarm', center=0,
                annot=True, fmt='.2f', square=True)
    plt.title('Feature Correlation Heatmap')
    plt.tight_layout()
    plt.show()

    # 3. Distribution of Suspicious Pattern Features
    suspicious_features = ['has_suspicious_words', 'has_suspicious_tld',
                         'has_ip', 'has_at_symbol', 'has_double_slash']

    fig, axes = plt.subplots(2, 3, figsize=(20, 12))
    fig.suptitle('Distribution of Suspicious Pattern Features', fontsize=16)

    for i, feature in enumerate(suspicious_features):
        row = i // 3
        col = i % 3
        sns.countplot(data=df_combined, x=feature, hue='label',
                     ax=axes[row, col], palette='Set2')
        axes[row, col].set_title(f'Distribution of {feature}')
        axes[row, col].legend(['Legitimate', 'Phishing'])

    plt.tight_layout()
    plt.show()

    # 4. Box Plots of Key Numerical Features
    selected_features = ['url_entropy', 'domain_entropy', 'num_suspicious_patterns',
                        'digit_ratio', 'special_char_ratio']

    fig, axes = plt.subplots(2, 3, figsize=(20, 12))
    fig.suptitle('Distribution of Key Numerical Features', fontsize=16)

    for i, feature in enumerate(selected_features):
        row = i // 3
        col = i % 3
        sns.boxplot(data=df_combined, y=feature, x='label', ax=axes[row, col],
                   palette='Set2')
        axes[row, col].set_title(f'Distribution of {feature}')
        axes[row, col].set_xticklabels(['Legitimate', 'Phishing'])

    plt.tight_layout()
    plt.show()

    # 5. Entropy Analysis
    entropy_features = ['url_entropy', 'domain_entropy', 'subdomain_entropy', 'path_entropy']
    entropy_data = pd.melt(df_combined,
                          value_vars=entropy_features,
                          id_vars=['label'])

    plt.figure(figsize=(12, 6))
    sns.boxplot(data=entropy_data, x='variable', y='value', hue='label',
                palette='Set2')
    plt.title('Entropy Analysis Across URL Components')
    plt.xticks(rotation=45)
    plt.legend(['Legitimate', 'Phishing'])
    plt.tight_layout()
    plt.show()

def train_and_evaluate_models(X_train, X_test, y_train, y_test):
    model_configs = {
        'Random Forest': RandomForestClassifier(n_estimators=200, random_state=RANDOM_SEED),
        'XGBoost': xgb.XGBClassifier(random_state=RANDOM_SEED),
        'LightGBM': lgb.LGBMClassifier(random_state=RANDOM_SEED),
        'CatBoost': cb.CatBoostClassifier(random_state=RANDOM_SEED, verbose=False),
        'Gradient Boosting': GradientBoostingClassifier(random_state=RANDOM_SEED)
    }

    results = {}
    for name, model in model_configs.items():
        print(f"\nTraining {name}...")
        try:
            model.fit(X_train, y_train)
            y_pred = model.predict(X_test)
            y_pred_proba = model.predict_proba(X_test)[:, 1]

            results[name] = {
                'predictions': y_pred,
                'probabilities': y_pred_proba,
                'model': model
            }
        except Exception as e:
            print(f"Error training {name}: {e}")
            continue

    return results

def compare_models(results, y_test):
    """Compare model performances with detailed metrics."""
    comparison = {}

    for model_name, result in results.items():
        y_pred = result['predictions']
        y_pred_proba = result['probabilities']

        comparison[model_name] = {
            'Accuracy': accuracy_score(y_test, y_pred),
            'ROC AUC': roc_auc_score(y_test, y_pred_proba),
            'Precision': precision_score(y_test, y_pred),
            'Recall': recall_score(y_test, y_pred),
            'F1': f1_score(y_test, y_pred),
            'Classification Report': classification_report(y_test, y_pred)
        }

    return comparison

if __name__ == "__main__":
    # 1. Data Collection
    print("Fetching URLs...")
    phishing_urls = fetch_phishing_urls_github(URL_LIMIT)
    legitimate_urls = fetch_legitimate_urls_majestic(URL_LIMIT)

    # Clean and prepare URLs
    phishing_urls = list(set([url for url in phishing_urls if url.startswith('http')]))
    legitimate_urls = list(set(legitimate_urls))

    # Balance dataset
    min_urls = min(len(phishing_urls), len(legitimate_urls))
    phishing_urls = phishing_urls[:min_urls]
    legitimate_urls = legitimate_urls[:min_urls]

    # Combine datasets
    all_urls = phishing_urls + legitimate_urls
    labels = [1] * len(phishing_urls) + [0] * len(legitimate_urls)

    # Shuffle
    combined = list(zip(all_urls, labels))
    random.shuffle(combined)
    all_urls, labels = zip(*combined)

    # 2. Feature Extraction
    print("\nExtracting features...")
    base_features_df = process_features_in_batches(all_urls, labels)
    tfidf_features_df = process_tfidf_in_batches(all_urls)

    # Combine features
    df_combined = pd.concat([base_features_df, tfidf_features_df], axis=1)
    df_combined['label'] = labels

    # 3. Prepare for modeling
    X = df_combined.drop('label', axis=1)
    y = df_combined['label']

    # Split and scale data
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.2, random_state=RANDOM_SEED, stratify=y
    )

    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled = scaler.transform(X_test)

    # 4. Train and evaluate models
    print("\nTraining and evaluating models...")
    results = train_and_evaluate_models(X_train_scaled, X_test_scaled, y_train, y_test)

    # 5. Generate comprehensive visualizations
    print("\nGenerating detailed visualizations...")
    comparison = compare_models(results, y_test)
    plot_detailed_model_comparison(comparison)

    # 6. Analyze best model
    best_model_name = max(comparison.items(), key=lambda x: x[1]['ROC AUC'])[0]
    print(f"\nBest performing model: {best_model_name}")
    best_model = results[best_model_name]
    joblib.dump(best_model, 'best_model.joblib')

    print("\nAnalyzing best model performance...")
    analyze_best_model(best_model, X_test_scaled, y_test, X.columns, df_combined)

    # 7. Explore dataset characteristics
    print("\nExploring dataset characteristics...")
    explore_dataset_characteristics(df_combined)

    print("\nAnalysis complete!")
